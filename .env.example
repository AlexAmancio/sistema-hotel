# Copiá este archivo como .env (no se sube al repositorio) y completá los valores.
# Spring Boot lo lee al arrancar (spring.config.import en application.properties).

# Usuario de MySQL de la aplicación, con permisos solo sobre la base alquiler.
# Crealo con: ./scripts/crear-usuario-bd.sh
DB_USER=estadia_app
DB_PASSWORD=

# Token de apiperu.dev para el autocompletado por DNI (https://apiperu.dev).
APIPERU_TOKEN=

# Clave que firma la cookie de "Recuérdame". Si queda vacía, se genera una al
# azar en cada arranque y las sesiones recordadas se pierden al reiniciar.
REMEMBER_ME_KEY=

# Correo para "olvidé mi contraseña" (Gmail con contraseña de aplicación).
MAIL_USERNAME=
MAIL_PASSWORD=

# Datos del hotel que se imprimen en la cabecera del comprobante.
HOTEL_RUC=
